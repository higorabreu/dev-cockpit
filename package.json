{
  "name": "dev-cockpit",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "build": "pnpm --filter @dck/ui build && pnpm --filter @dck/shell build",
    "package": "pnpm build && node packages/shell/scripts/package-deb.mjs",
    "package:mac": "pnpm build && node packages/shell/scripts/package-mac.mjs",
    "install:local": "bash scripts/install-local.sh",
    "dev": "pnpm build && node scripts/dev.mjs",
    "dev:dck": "node scripts/dev.mjs cli",
    "postinstall": "node scripts/fix-node-pty.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/node": "24",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/higorabreu/dev-cockpit.git"
  },
  "bugs": {
    "url": "https://github.com/higorabreu/dev-cockpit/issues"
  },
  "homepage": "https://github.com/higorabreu/dev-cockpit#readme",
  "description": "A Guake-style terminal cockpit for developers"
}
