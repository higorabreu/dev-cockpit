#!/bin/bash
# Stand-in for secret-tool in the recordings: keeps the fixtures' fake tokens in $FAKE_KEYRING, one file per key
dir="${FAKE_KEYRING:?}"
mkdir -p "$dir"
cmd="$1"
shift
key=""
while [ $# -gt 0 ]; do
  case "$1" in
    key) key="$2"; shift 2 ;;
    *) shift ;;
  esac
done
file="$dir/$(printf '%s' "$key" | tr '/:' '__')"
case "$cmd" in
  lookup) [ -f "$file" ] && cat "$file" ;;
  store) cat > "$file" ;;
  clear) rm -f "$file" ;;
  *) exit 2 ;;
esac
