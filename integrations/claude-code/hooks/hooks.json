{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v dck >/dev/null 2>&1 && dck agent signal working || true",
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v dck >/dev/null 2>&1 && dck agent signal working || true",
            "async": true
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v dck >/dev/null 2>&1 && dck agent signal needs-you || true",
            "async": true
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "command -v dck >/dev/null 2>&1 && dck agent signal needs-you || true",
            "async": true
          }
        ]
      },
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "command -v dck >/dev/null 2>&1 && dck agent signal your-turn || true",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v dck >/dev/null 2>&1 && dck agent signal your-turn || true",
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v dck >/dev/null 2>&1 && dck agent signal ended || true",
            "async": true
          }
        ]
      }
    ]
  }
}
